# Copy this file to .env and fill in real values — NEVER commit .env

# Downstream Spring Boot services
SPRING_BOOT_URL=http://localhost:8081
SESSION_SERVICE_URL=http://localhost:8084

# Agent server
AGENT_PORT=8765
LOCAL_ONLY=false

# Security
GATEWAY_SECRET=change-in-production

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# Screen analysis — local Ollama vision LLM (no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:e4b

# Track report AI conclusion — OpenRouter (optional)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct

DEBUG=false
