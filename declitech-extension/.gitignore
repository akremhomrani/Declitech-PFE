# Browser Extension .gitignore

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Node modules (if using build tools)
node_modules/
npm-debug.log
yarn-error.log

# Build outputs
dist/
build/
*.zip
*.crx
*.xpi

# Environment files
.env
.env.local

# Logs
*.log

# Temporary files
*.tmp
*.temp

# Local settings that shouldn't be committed
local-settings.json
