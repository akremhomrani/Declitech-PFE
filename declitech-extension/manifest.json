{
  "manifest_version": 3,
  "name": "DecliTrack - Join Session",
  "version": "2.4.0",
  "description": "Join session + detect pseudonyme/email from the current page.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DecliTrack"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learn.decli.tech/*",
        "http://localhost:4200/*"
      ],
      "js": [
        "content_decli_app.js",
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://learn.decli.tech/*",
        "https://fr.vittascience.com/*"
      ],
      "js": [
        "content_learn_declitech_ai.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://app.decli.tech/*",
    "https://learn.decli.tech/*",
    "https://api-iam.decli.tech/*",
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://localhost:8081/*",
    "http://localhost:8083/*",
    "https://fr.vittascience.com/*"
  ]
}
