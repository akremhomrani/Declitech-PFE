{
  "manifest_version": 3,
  "name": "DecliTech - Join Session",
  "version": "2.1.0",
  "description": "Join session + detect pseudonyme/email from the current page.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DecliTech"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8083/*",
    "https://*/*"
  ]
}