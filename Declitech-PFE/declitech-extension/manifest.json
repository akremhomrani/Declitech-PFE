{
  "manifest_version": 3,
  "name": "DecliTech - Join Session",
  "version": "2.3.0",
  "description": "Join session + detect pseudonyme/email from the current page.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "DecliTech"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codecombat.com/*",
        "https://www.codecombat.com/*",
        "https://code.org/*",
        "https://studio.code.org/*",
        "https://app.decli.tech/*",
        "http://localhost:4200/*"
      ],
      "js": [
        "content_pedagogy_codecombat.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://localhost:8765/*",
    "http://localhost:8081/*",
    "http://localhost:8083/*",
    "https://*/*",
    "http://*/*"
  ]
}