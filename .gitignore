# Root workspace .gitignore

# Virtual environments
.venv/
venv/
ENV/
env/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS files
.DS_Store
Thumbs.db
Desktop.ini
ehthumbs.db

# Node
node_modules/
npm-debug.log
yarn-error.log
package-lock.json

# Logs
*.log
logs/

# Environment files
.env
.env.local
.env.*.local

# Build outputs
dist/
build/
target/
out/

# Archives
*.zip
*.rar

# Markdown files
*.md

# JSON files
*.json

# Claude directory
.claude/
.code-review-graph/

# Temporary files
*.tmp
*.temp
.cache/

# Python compiled
__pycache__/
*.py[cod]
*.pyo

# Angular cache
.angular/

# Redis dump
Redis/dump.rdb
dump.rdb

# Keep .env.example even though *.env would catch it
!.env.example

# Maven wrapper jar (keep properties file)
.mvn/wrapper/maven-wrapper.jar

# Docker override (local only)
docker-compose.override.yml
